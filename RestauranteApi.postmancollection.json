{
  "info": {
    "name": "RestauranteApi",
    "description": "Pruebas de la API de reservas del restaurante. Ejecutar la API con: dotnet run --urls http://localhost:5000. Ejecutar en orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" }
  ],
  "item": [
    {
      "name": "CLIENTES",
      "item": [
        {
          "name": "1. POST - Registrar cliente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"dni\": \"12345678\",\n  \"nombreCompleto\": \"Juan Perez\",\n  \"telefono\": \"987654321\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/clientes", "host": ["{{baseUrl}}"], "path": ["api", "clientes"] }
          }
        },
        {
          "name": "2. GET - Listar clientes",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/clientes", "host": ["{{baseUrl}}"], "path": ["api", "clientes"] }
          }
        },
        {
          "name": "3. GET - Cliente por DNI",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/clientes/12345678", "host": ["{{baseUrl}}"], "path": ["api", "clientes", "12345678"] }
          }
        },
        {
          "name": "4. PUT - Actualizar cliente",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombreCompleto\": \"Juan Perez Garcia\",\n  \"telefono\": \"999888777\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/clientes/12345678", "host": ["{{baseUrl}}"], "path": ["api", "clientes", "12345678"] }
          }
        }
      ]
    },
    {
      "name": "MESAS",
      "item": [
        {
          "name": "5. GET - Listar mesas",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/mesas", "host": ["{{baseUrl}}"], "path": ["api", "mesas"] }
          }
        },
        {
          "name": "6. GET - Mesas libres a una hora",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/mesas?fechaHora=2030-12-10T20:00:00",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mesas"],
              "query": [{ "key": "fechaHora", "value": "2030-12-10T20:00:00" }]
            }
          }
        }
      ]
    },
    {
      "name": "RESERVAS",
      "item": [
        {
          "name": "7. POST - Registrar reserva",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"clienteDni\": \"12345678\",\n  \"numeroMesa\": 2,\n  \"fechaHora\": \"2030-12-10T20:00:00\",\n  \"cantidadPersonas\": 4\n}" },
            "url": { "raw": "{{baseUrl}}/api/reservas", "host": ["{{baseUrl}}"], "path": ["api", "reservas"] }
          }
        },
        {
          "name": "8. GET - Listar reservas",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/reservas", "host": ["{{baseUrl}}"], "path": ["api", "reservas"] }
          }
        },
        {
          "name": "9. GET - Reserva por id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/reservas/1", "host": ["{{baseUrl}}"], "path": ["api", "reservas", "1"] }
          }
        },
        {
          "name": "10. PUT - Actualizar reserva",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fechaHora\": \"2030-12-10T21:00:00\",\n  \"cantidadPersonas\": 3\n}" },
            "url": { "raw": "{{baseUrl}}/api/reservas/1", "host": ["{{baseUrl}}"], "path": ["api", "reservas", "1"] }
          }
        },
        {
          "name": "11. PATCH - Finalizar reserva",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/api/reservas/1/finalizar", "host": ["{{baseUrl}}"], "path": ["api", "reservas", "1", "finalizar"] }
          }
        },
        {
          "name": "12. DELETE - Cancelar reserva",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/reservas/1", "host": ["{{baseUrl}}"], "path": ["api", "reservas", "1"] }
          }
        }
      ]
    },
    {
      "name": "ERRORES",
      "item": [
        {
          "name": "13. ERROR 400 - Datos invalidos (DNI y personas)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"clienteDni\": \"123\",\n  \"numeroMesa\": 2,\n  \"fechaHora\": \"2030-12-10T20:00:00\",\n  \"cantidadPersonas\": 50\n}" },
            "url": { "raw": "{{baseUrl}}/api/reservas", "host": ["{{baseUrl}}"], "path": ["api", "reservas"] }
          }
        },
        {
          "name": "14. ERROR 400 - Fecha en el pasado",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"clienteDni\": \"12345678\",\n  \"numeroMesa\": 2,\n  \"fechaHora\": \"2020-01-01T20:00:00\",\n  \"cantidadPersonas\": 4\n}" },
            "url": { "raw": "{{baseUrl}}/api/reservas", "host": ["{{baseUrl}}"], "path": ["api", "reservas"] }
          }
        },
        {
          "name": "15. ERROR 400 - Mesa sin capacidad (mesa 1 es de 2 personas)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"clienteDni\": \"12345678\",\n  \"numeroMesa\": 1,\n  \"fechaHora\": \"2031-01-10T20:00:00\",\n  \"cantidadPersonas\": 6\n}" },
            "url": { "raw": "{{baseUrl}}/api/reservas", "host": ["{{baseUrl}}"], "path": ["api", "reservas"] }
          }
        },
        {
          "name": "16. ERROR 404 - Reserva que no existe",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/reservas/999", "host": ["{{baseUrl}}"], "path": ["api", "reservas", "999"] }
          }
        },
        {
          "name": "17. ERROR 409 - Cliente repetido (ejecutar tras la peticion 1)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"dni\": \"12345678\",\n  \"nombreCompleto\": \"Otro Nombre\",\n  \"telefono\": \"987654321\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/clientes", "host": ["{{baseUrl}}"], "path": ["api", "clientes"] }
          }
        }
      ]
    }
  ]
}
