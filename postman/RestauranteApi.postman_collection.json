{
  "info": {
    "name": "RestauranteApi - Pruebas de parcial",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Fechas para cambiar si ya pasaron; ejecutar en orden y capturar resultados reales."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "reservaId",
      "value": "3"
    }
  ],
  "item": [
    {
      "name": "01 Clientes - listar",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/clientes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"200\", () => pm.response.to.have.status(200));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "02 Clientes - registrar",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/clientes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dni\": \"11112222\",\n  \"nombreCompleto\": \"María López\",\n  \"telefono\": \"987123456\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"201\", () => pm.response.to.have.status(201));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "03 Mesas - disponibilidad",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/mesas?fechaHora=2027-12-10T19:00:00&personas=4"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"200\", () => pm.response.to.have.status(200));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "04 Reservas - registrar",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/reservas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clienteDni\": \"11112222\",\n  \"numeroMesa\": 3,\n  \"fechaHora\": \"2027-12-10T19:00:00\",\n  \"cantidadPersonas\": 4\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"reservaId\", pm.response.json().id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "05 Reservas - listar",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/reservas"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"200\", () => pm.response.to.have.status(200));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "06 Reservas - actualizar",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/reservas/{{reservaId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fechaHora\": \"2027-12-10T21:30:00\",\n  \"cantidadPersonas\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"200\", () => pm.response.to.have.status(200));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "07 Error - horario repetido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/reservas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clienteDni\": \"11112222\",\n  \"numeroMesa\": 3,\n  \"fechaHora\": \"2027-12-10T21:00:00\",\n  \"cantidadPersonas\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"409\", () => pm.response.to.have.status(409));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "08 Error - mesa inexistente",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/mesas/999"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"404\", () => pm.response.to.have.status(404));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "09 Error - DNI inválido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/clientes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dni\": \"12\",\n  \"nombreCompleto\": \"Prueba\",\n  \"telefono\": \"987123456\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"400\", () => pm.response.to.have.status(400));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "10 Reservas - cancelar",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/reservas/{{reservaId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"204\", () => pm.response.to.have.status(204));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
